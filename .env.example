# --- обязательное -----------------------------------------------------------

# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Строка подключения к Postgres.
# На Vercel подставляется сама, если подключить базу через Storage → Neon.
# Локально сюда можно вписать ту же строку из панели Neon.
DATABASE_URL=postgresql://user:password@host/dbname

# --- необязательное ---------------------------------------------------------

# Публичный адрес мини-приложения. Локально его пишет start.sh (туннель),
# на Vercel берётся домен проекта. Задавай вручную только для своего домена.
WEBAPP_URL=

# Локальный сервер
HOST=0.0.0.0
PORT=8080

# Часовой пояс по умолчанию (смещение от UTC в часах)
DEFAULT_TZ_OFFSET=3

# 1 — открывать мини-апп в обычном браузере без Telegram (только для разработки!)
DEV_MODE=0

# Секреты вебхука и cron выводятся из BOT_TOKEN автоматически.
# Переопределяй, только если нужны свои значения.
# WEBHOOK_SECRET=
# CRON_SECRET=
