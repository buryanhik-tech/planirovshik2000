# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Публичный HTTPS-адрес мини-приложения (ngrok / cloudflared / свой домен)
# Именно его нужно указать в @BotFather -> Bot Settings -> Menu Button
WEBAPP_URL=

# Хост/порт локального сервера
HOST=0.0.0.0
PORT=8080

# Часовой пояс пользователей по умолчанию (смещение от UTC в часах)
DEFAULT_TZ_OFFSET=3

# 1 — разрешить открывать мини-апп в обычном браузере без Telegram (для разработки)
DEV_MODE=1
